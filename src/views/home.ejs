<div class="portfolio-shell">
    <header class="portfolio-header">
        <div>
            <p class="eyebrow">Portfolio Directory</p>
            <h1>My Portfolio</h1>
        </div>
        <a href="/form" class="primary-btn">Add new profile</a>
    </header>

    <% if (submitted) { %>
        <div class="notice success-notice">Portfolio submitted successfully.</div>
    <% } %>

    <% const latestPerson = portfolioData && portfolioData.length ? portfolioData[0] : null; %>

    <% if (latestPerson) { %>
        <article class="portfolio-card">
            <div class="card-topline">
                <h2><%= latestPerson.name || 'Unnamed profile' %></h2>
                <span class="badge"><%= latestPerson.gender || 'Not specified' %></span>
            </div>

            <div class="meta-grid">
                <p><strong>Email:</strong> <%= latestPerson.email || 'N/A' %></p>
                <p><strong>Phone:</strong> <%= latestPerson.phone || 'N/A' %></p>
                <p><strong>DOB:</strong> <%= latestPerson.dob || 'N/A' %></p>
                <p><strong>Location:</strong> <%= latestPerson.city || 'N/A' %>, <%= latestPerson.state || 'N/A' %></p>
                <p><strong>Pincode:</strong> <%= latestPerson.pincode || 'N/A' %></p>
                <p><strong>Address:</strong> <%= latestPerson.address || 'N/A' %></p>
            </div>

            <div class="info-block">
                <h3>About Me</h3>
                <p><%= latestPerson.abMe || 'No details added yet.' %></p>
            </div>

            <div class="info-block">
                <h3>Skills</h3>
                <p><%= latestPerson.skills || 'No skills listed.' %></p>
            </div>

            <div class="info-block">
                <h3>Qualifications</h3>
                <p><%= latestPerson.qualifications || 'No qualifications listed.' %></p>
            </div>

            <div class="social-links">
                <a href="<%= latestPerson.linkedin || '#' %>" target="_blank" rel="noreferrer">LinkedIn</a>
                <a href="<%= latestPerson.github || '#' %>" target="_blank" rel="noreferrer">GitHub</a>
                <% if (latestPerson.resume) { %>
                    <a href="<%= latestPerson.resume %>" target="_blank" rel="noreferrer">Resume</a>
                <% } else { %>
                    <span class="resume-disabled">Resume not uploaded</span>
                <% } %>
            </div>
        </article>
    <% } else { %>
        <div class="empty-state">
            <h2>No portfolio entries yet.</h2>
            <p>Fill out the portfolio form to add your first profile.</p>
        </div>
    <% } %>
</div>